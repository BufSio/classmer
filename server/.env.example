# Secretos de Classmer. `classmer init` copia este archivo a Classmer-data\.env (fuera del repo).
# Nunca lo subas a git ni pegues su contenido en un chat.

# Token Bearer que usa la app. `classmer init` lo genera solo; `classmer token` lo muestra.
CLASSMER_TOKEN=

# Clave de la API de Gemini (tier pago). Pegala vos directamente en este archivo.
GEMINI_API_KEY=

# Clave de la API de Anthropic (opcional). Con ella, Classmer puede pagar lo que le pide a Claude
# con la API en vez del plan Max (ver `claude.facturacion` en config.yaml). Sólo se lee de este
# archivo, nunca del entorno. Pegala vos directamente acá.
ANTHROPIC_API_KEY=
